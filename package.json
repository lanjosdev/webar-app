{
  "name": "webar-world-tracking-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "copy:engine": "node scripts/copy-8thwall-engine.mjs",
    "predev": "npm run copy:engine",
    "dev": "vite --host",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run copy:engine",
    "build": "tsc --noEmit && vite build",
    "postbuild": "npm run verify:engine-license && npm run audit:build",
    "audit:build": "node scripts/audit-production-build.mjs",
    "verify:deployment": "node scripts/verify-vercel-deployment.mjs",
    "verify:engine-license": "node scripts/verify-8thwall-license.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
